{
  "name": "floor-100000-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "第100000层：末日宿舍 — Electron 桌面壳（AG-76）：窗口/存档桥/三平台打包，Steam 上架技术路径",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --dir",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder -mwl --publish never"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^26.18.0"
  }
}
