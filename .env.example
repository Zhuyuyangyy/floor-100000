# AI NPC 推理配置示例
#
# 复制为 .env.local 后按需修改。.env.local 已被 .gitignore 忽略，
# 不要把真实地址、Token 或模型服务密钥提交进仓库。

# 是否启用 AI NPC（false 时不发任何请求，纯离线规则脑）
VITE_NPC_ENABLED=true

# Ollama 地址。本机走 SSH 隧道时保持默认：
#   127.0.0.1:11434 -> DGX Spark 127.0.0.1:11434
VITE_OLLAMA_URL=http://127.0.0.1:11434

# 模型名。npc-qwen 是带思维链的模型，必须配合 VITE_NPC_THINK=off 使用。
VITE_NPC_MODEL=npc-qwen:latest

# 单次推理超时（毫秒）。冷启动首次加载约 33s，热推理约 3s。
VITE_NPC_TIMEOUT_MS=45000

# 输出 token 上限。关闭思维链后 192 足够；被截断会自动放宽重试一次。
VITE_NPC_MAX_TOKENS=192

# 思维链开关：off（默认）/ on
# 带 thinking 的模型（npc-qwen / qwen3.8 系列）开思维链时会先写 reasoning，
# 若同时限了输出预算，正文会变成空串——HTTP 200 但 content 为空，
# 表现为「NPC 不说话、也没有任何行动」。默认关闭。
VITE_NPC_THINK=off